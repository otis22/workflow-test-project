{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "otis22/taskflow",
    "type": "project",
    "description": "TaskFlow MVP application bootstrap.",
    "keywords": ["taskflow", "laravel", "tasks"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "infection/infection": "^0.32.6",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "APP_ENV=testing DB_CONNECTION=sqlite DB_DATABASE=:memory: php artisan test"
        ],
        "test:unit": [
            "APP_ENV=testing DB_CONNECTION=sqlite DB_DATABASE=:memory: php artisan test --testsuite=Unit"
        ],
        "test:feature": [
            "APP_ENV=testing DB_CONNECTION=sqlite DB_DATABASE=:memory: php artisan test --testsuite=Feature"
        ],
        "test:e2e": [
            "APP_ENV=testing DB_CONNECTION=sqlite DB_DATABASE=:memory: php artisan test --testsuite=E2E"
        ],
        "test:coverage": [
            "APP_ENV=testing DB_CONNECTION=sqlite DB_DATABASE=:memory: php -d pcov.enabled=1 artisan test --coverage"
        ],
        "test:coverage:gate": [
            "APP_ENV=testing DB_CONNECTION=sqlite DB_DATABASE=:memory: php -d pcov.enabled=1 artisan test --coverage --min=94"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "cpd": [
            "npx jscpd app tests routes --silent --config .jscpd.json"
        ],
        "rector": [
            "vendor/bin/rector process --dry-run"
        ],
        "mutate": [
            "vendor/bin/infection --threads=2 --min-msi=100 --min-covered-msi=100"
        ],
        "deps:audit": [
            "composer audit"
        ],
        "quality": [
            "@lint",
            "@analyse",
            "@test",
            "@test:coverage:gate",
            "@cpd",
            "@rector",
            "@deps:audit"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
