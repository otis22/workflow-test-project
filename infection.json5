{
    "$schema": "./vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "app/Domain",
            "app/Application"
        ]
    },
    "logs": {
        "text": "storage/infection/infection.log",
        "html": "storage/infection/infection.html"
    },
    "mutators": {
        "@default": true
    },
    "testFramework": "phpunit",
    "phpUnit": {
        "customPath": "./vendor/bin/pest"
    },
    "minMsi": 0,
    "minCoveredMsi": 0
}
